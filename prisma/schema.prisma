generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  password String
  role     String   // admin / staff

  documents Document[]
}
model Document {
  id        Int      @id @default(autoincrement())
  title     String
  sender    String?
  documentDate DateTime?
  filePath    String?
  fileId      String?
  storageType String  @default("gdrive") // local / gdrive
  type        String   // masuk / keluar / sertifikat
  status    String   @default("pending") // pending / verified / rejected
  createdAt DateTime @default(now())

  createdBy Int
  user      User     @relation(fields: [createdBy], references: [id])
  
  // JSON strings untuk menyimpan array ID
  approverIds    String? 
  approvedByIds  String? 
  
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model Notification {
  id         Int      @id @default(autoincrement())
  userId     Int
  documentId Int
  message    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId, isRead])
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  action     String
  documentId Int?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([documentId])
  @@index([createdAt])
}
